{% set t = i18n[lang] %}
<!DOCTYPE html>
<html lang="{{ lang }}" class="no-js">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">

  {# Path-prefix hint read by <tdc-duck> to build lazy-loaded asset URLs. #}
  <meta name="path-prefix" content="{{ '/' | url }}">

  {# Apply stored theme + enable JS hooks before first paint (no FOUC). #}
  <script>
    (function () {
      try {
        var t = localStorage.getItem("tdc-theme");
        if (t === "light" || t === "dark") {
          document.documentElement.setAttribute("data-theme", t);
        }
      } catch (e) {}
      var de = document.documentElement;
      de.classList.remove("no-js");
      de.classList.add("js");
    })();
  </script>

  <title>{{ title | default(site.title) }}</title>
  <meta name="description" content="{{ description | default(site.description) | excerpt(200) }}">
  {# Pages that only repeat the home page canonical to it; a page with content
     of its own (a talk) sets canonical: true and points at itself. #}
  <link rel="canonical" href="{{ site.url }}{{ page.url if canonical else ('/en/' if lang == 'en' else '/') }}">

  {# Theme colour matches the design tokens (dark default / light override). #}
  <meta name="theme-color" content="#0F0F0F" media="(prefers-color-scheme: dark)">
  <meta name="theme-color" content="#FEFEFE" media="(prefers-color-scheme: light)">

  {# Open Graph / social #}
  <meta property="og:type" content="{{ ogType | default('website') }}">
  <meta property="og:title" content="{{ title | default(site.title) }}">
  <meta property="og:description" content="{{ description | default(site.description) | excerpt(200) }}">
  <meta property="og:locale" content="{{ 'en_GB' if lang == 'en' else 'nb_NO' }}">
  <meta property="og:site_name" content="{{ site.title }}">
  <meta property="og:url" content="{{ site.url }}{{ page.url }}">
  {# Same share image everywhere (the one LinkedIn picked up from the home page);
     social crawlers need an absolute URL. #}
  <meta property="og:image" content="{{ site.url }}/assets/images/komite.jpg">
  <meta property="og:image:width" content="800">
  <meta property="og:image:height" content="534">
  <meta name="twitter:card" content="summary_large_image">

  {# The SVG icon swaps colours itself (prefers-color-scheme inside the SVG):
     red on white in light mode, green on black in dark, like the wordmark.
     The PNG fallbacks do the same through media queries on the links. #}
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/images/favicon-light-32x32.png' | url }}" media="(prefers-color-scheme: light)">
  <link rel="icon" type="image/png" sizes="32x32" href="{{ '/assets/images/favicon-32x32.png' | url }}" media="(prefers-color-scheme: dark)">
  <link rel="icon" type="image/svg+xml" href="{{ '/assets/images/favicon.svg' | url }}">
  <link rel="apple-touch-icon" sizes="180x180" href="{{ '/assets/images/apple-touch-icon-180x180.png' | url }}">

  {# Preload the fonts the first screen needs (latin), so they don't wait for
     main.css and its @import chain to be discovered: body text, and Space
     Grotesk for the hero date (400) and the nav (600, served by the 700 file). #}
  <link rel="preload" href="{{ '/assets/fonts/ibm-plex-sans-latin-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/ibm-plex-sans-latin-600-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/space-grotesk-latin-400-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>
  <link rel="preload" href="{{ '/assets/fonts/space-grotesk-latin-700-normal.woff2' | url }}" as="font" type="font/woff2" crossorigin>

  <link rel="stylesheet" href="{{ '/assets/css/main.css' | url }}">

  {# Plausible analytics (privacy-friendly, self-hosted, no cookies). #}
  {% if site.analytics.scriptId %}
  <script async src="{{ site.analytics.host }}/js/{{ site.analytics.scriptId }}.js"></script>
  <script>
    window.plausible=window.plausible||function(){(plausible.q=plausible.q||[]).push(arguments)},plausible.init=plausible.init||function(i){plausible.o=i||{}};
    plausible.init({ hashBasedRouting: true })
  </script>
  {% endif %}
</head>
<body>
  <a href="#main" class="skip-link">{{ t.ui.skip }}</a>

  {% include "partials/nav.njk" %}

  <main id="main">
    {{ content | safe }}
  </main>

  {% if site.featureFlags.partners %}{% include "partials/partner-wall.njk" %}{% endif %}
  {% include "partials/footer.njk" %}
  {% include "partials/brand-menu.njk" %}

  <script type="module" src="{{ '/assets/js/main.js' | url }}"></script>
</body>
</html>
