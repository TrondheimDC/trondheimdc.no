{% from "components/session-language.njk" import sessionLanguage %}
<tdc-section>
<section class="section section--surface" id="speakers" aria-labelledby="speakers-title">
  <div class="container container--wide stack">
    <header class="section__header">
      <h2 class="section__title text-h1" id="speakers-title">{{ t.speakers.title }}</h2>
    </header>

    {# Custom speaker wall using Sessionize API data #}
    <div
      class="speakers-wall"
      data-sessionize-event-id="{{ site.sessionizeEventId }}"
      data-top-speaker-ids="{{ sessionize.topSpeakerIds | json | escape }}"
    >
      {% if sessionize.speakers and sessionize.speakers.length > 0 %}
        <ul class="speakers-grid" role="list">
          {% for speaker in sessionize.speakers %}
            <li class="speaker-item" id="speaker-{{ speaker.id }}">
              <button
                type="button"
                class="speaker-card"
                data-speaker-open
                data-speaker-id="{{ speaker.id | escape }}"
                data-speaker-name="{{ (speaker.firstName + ' ' + speaker.lastName) | escape }}"
                data-speaker-image="{{ speaker.profilePicture | escape }}"
                data-speaker-tagline="{{ speaker.tagLine | escape }}"
                data-speaker-bio="{{ speaker.bio | escape }}"
                data-speaker-twitter="{{ speaker.twitter | escape }}"
                data-speaker-linkedin="{{ speaker.linkedIn | escape }}"
                data-speaker-blog="{{ speaker.blog | escape }}"
                {% set talk = sessionize.sessions | sessionById(speaker.sessions[0]) %}
                data-speaker-talk-title="{{ talk.title | escape }}"
                data-speaker-talk-description="{{ talk.description | escape }}"
              >
                {% if speaker.profilePicture %}
                  <img
                    src="{{ speaker.profilePicture }}"
                    alt=""
                    class="speaker-card__avatar"
                  />
                {% endif %}

                <span class="speaker-card__name">
                  {{ speaker.firstName }} {{ speaker.lastName }}
                </span>

                {% if talk %}
                  <span class="speaker-card__talk">{{ talk.title }}</span>
                  {{ sessionLanguage(talk.language, t) }}
                {% endif %}

                <span class="speaker-card__more">{{ t.speakers.details_cta }}</span>
              </button>
            </li>
          {% endfor %}
        </ul>

        {% include "partials/speaker-modal.njk" %}

        {# Cloned by the client-side refresh when it rebuilds the grid. #}
        <template data-language-badges>{{ sessionLanguage("en", t) }}{{ sessionLanguage("no", t) }}</template>
      {% else %}
        <p class="section__lead text-lead">{{ t.speakers.placeholder }}</p>
      {% endif %}
    </div>
  </div>
</section>
</tdc-section>
