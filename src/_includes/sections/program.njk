{% from "components/session-language.njk" import sessionLanguage %}
<tdc-section>
<section class="section" id="program" aria-labelledby="program-title">
  <div class="container container--wide stack">
    <header class="section__header">
      {# Standalone /program/ page: the schedule is the page, so it owns the h1. #}
      {% if standalone %}
        <h1 class="section__title text-h1" id="program-title">{{ t.program.title }}</h1>
      {% else %}
        <h2 class="section__title text-h1" id="program-title">{{ t.program.title }}</h2>
      {% endif %}
    </header>

    <div
      class="program-schedule"
      aria-label="{{ t.program.title }}"
      data-sessionize-event-id="{{ site.sessionizeEventId }}"
      data-favorites-key="tdc-favorites-{{ sessionize.eventId }}"
      data-star-label="{{ t.program.star }}"
      data-unstar-label="{{ t.program.unstar }}"
      data-all-topics-label="{{ t.program.all_topics }}"
      data-topic-label="{{ t.program.topic }}"
      data-filter-count-label="{{ t.program.filter_count | escape }}"
      data-no-results-label="{{ t.program.no_results | escape }}"
      data-favorite-hint-label="{{ t.program.favorite_hint | escape }}"
      data-shared-session-label="{{ t.program.shared_session }}"
      data-calendar-url="{{ site.url }}{{ page.url }}{% if not standalone %}#program{% endif %}"
      data-calendar-ics-base="{{ '/program/' | url }}"
      data-calendar-saved-name="{{ t.program.calendar_saved_name | escape }}"
      data-speaker-singular-label="{{ t.program.speaker_singular | escape }}"
      data-speaker-plural-label="{{ t.program.speaker_plural | escape }}"
      data-live-now-label="{{ t.program.live_now | escape }}"
      data-live-past-label="{{ t.program.live_past | escape }}"
      data-live-show-earlier-label="{{ t.program.live_show_earlier | escape }}"
      data-live-hide-earlier-label="{{ t.program.live_hide_earlier | escape }}"
      data-live-show-earlier-name="{{ t.program.live_show_earlier_name | escape }}"
      data-live-hide-earlier-name="{{ t.program.live_hide_earlier_name | escape }}"
      data-live-storage-key="tdc-program-live-{{ sessionize.eventId }}"
    >
      {% if sessionize.schedule.rows and sessionize.schedule.rows.length > 0 %}
        <h3 class="program-schedule__date">{{ sessionize.schedule.date | date(lang) }}</h3>

        {# One line: search, topic, and the saved-talks pair. The search and
           topic labels are visually hidden but real, and the topic pill shows
           its own "Tema" prefix, so the chosen value never reads without it. #}
        <div class="program-filters">
          <label class="visually-hidden" for="program-search">{{ t.program.search_label }}</label>
          <div class="program-filters__search">
            <svg class="program-filters__search-icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
            <input class="program-filters__search-input" id="program-search" type="search" data-program-search placeholder="{{ t.program.search_placeholder | escape }}" autocomplete="off" enterkeyhint="search" />
            <button type="button" class="program-filters__search-clear" data-program-search-clear aria-label="{{ t.program.search_clear }}" hidden>
              <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
          <label class="program-filters__topic">
            <span class="program-filters__topic-prefix">{{ t.program.topic }}</span>
            <select class="program-filters__topic-select" data-program-topic-filter>
              <option value="">{{ t.program.all_topics }}</option>
              {% for topic in sessionize.schedule.topics %}
                <option value="{{ topic | escape }}">{{ topic }}</option>
              {% endfor %}
            </select>
            <svg class="program-filters__topic-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </label>
          {# One label; aria-pressed carries the state and the star fills with
             it (same .favorite-star rule as the cards). Flipping the label to
             "Vis alle foredrag" would read "show all talks, pressed". #}
          <button type="button" class="program-schedule__filter program-schedule__favorites-only" data-program-favorites-only aria-pressed="false">
            <svg class="favorite-star" viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.41L14.13 9.97L21.04 9.97L15.45 14.03L17.58 20.59L12 16.54L6.42 20.59L8.55 14.03L2.96 9.97L9.87 9.97Z"/></svg>
            {{ t.program.show_favorites }}
            <span class="program-filters__count" data-program-favorites-count hidden></span>
          </button>
          <button type="button" class="program-schedule__filter" data-program-calendar-export disabled>
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
            {{ t.program.calendar_saved }}
          </button>
        </div>

        {# One muted line under the bar: how to save a talk until you have,
           then "showing 4 of 45" once a filter narrows the grid, with a way
           back — and, on the day, the live toggle at its end. The text is a
           polite live region that stays in the DOM (a region revealed as it
           changes is often not announced). #}
        <div class="program-filters__status" data-program-filter-status>
          <p class="program-filters__status-text" data-program-filter-count aria-live="polite">{{ t.program.favorite_hint }}</p>
          <button type="button" class="program-filters__reset" data-program-filter-reset hidden>{{ t.program.filter_reset }}</button>
          {# The live view's controls ride on the same line, pushed right —
             no row of their own. Revealed by tdc-program-live.js only while
             the conference day is running. The toggle keeps one label and
             aria-pressed carries the state (drawn as a switch); the short line
             beside it is visible on purpose and is also its aria-describedby:
             "what happens if I press this" is a question for everyone, and a
             tooltip never shows on a phone. #}
          <div class="program-live" data-program-live-bar hidden>
            <button type="button" class="program-live__toggle program-schedule__live-toggle" data-program-live-toggle aria-pressed="false" aria-describedby="program-live-desc">
              <span class="program-live__switch" aria-hidden="true"></span>
              {{ t.program.live_toggle }}
            </button>
            <span class="program-live__hint" id="program-live-desc">{{ t.program.live_description }}</span>
            <button type="button" class="program-live__earlier program-schedule__live-earlier" data-program-live-earlier aria-expanded="false" hidden></button>
          </div>
        </div>

        <div class="program-schedule__grid" style="--program-room-count: {{ sessionize.schedule.rooms.length }}">
          <div class="program-schedule__now" data-program-now hidden aria-hidden="true">
            <span class="program-schedule__now-time" data-program-now-time></span>
          </div>

          <div class="program-schedule__rooms" aria-hidden="true">
            <span></span>
            {% for room in sessionize.schedule.rooms %}
              <span class="program-schedule__room-label">{{ room.name }}</span>
            {% endfor %}
          </div>

          {% for row in sessionize.schedule.rows %}
            <div class="program-schedule__row" data-program-time="{{ row.startsAt }}">
              <time class="program-schedule__time" datetime="{{ row.startsAt }}">{{ row.startsAt | isoTime }}</time>
              <div class="program-schedule__sessions">
                {% for session in row.sessions %}
                  <article
                    class="program-session{% if session.isService %} program-session--service{% endif %}{% if session.isPlenum %} program-session--plenum{% endif %}{% if session.isLongService %} program-session--long-service-in-row{% endif %}{% if not session.isService %} program-session--favoritable{% endif %}"
                    style="--program-room-start: {{ session.roomStart + 1 }}; --program-room-end: {{ session.roomEnd + 2 }}"
                    data-program-session
                    data-session-id="{{ session.id | escape }}"
                    data-session-title="{{ session.title | escape }}"
                    data-session-description="{{ session.description | escape }}"
                    data-session-start="{{ session.startsAt | isoTime }}"
                    data-session-end="{{ session.endsAt | isoTime }}"
                    data-session-start-at="{{ session.startsAt }}"
                    data-session-end-at="{{ session.endsAt }}"
                    data-session-room="{{ session.roomName | escape }}"
                    data-session-service="{{ 'true' if session.isService else 'false' }}"
                    data-session-topics="{{ session.topics | join('|') | escape }}"
                  >
                    <div class="program-session__meta">
                      <span class="program-session__room">{% if session.title == "Lunch" %}{{ t.program.lunch_location }}{% else %}{{ session.roomName or t.program.shared_session }}{% endif %}</span>
                      <span class="program-session__duration">{{ session.startsAt | isoTime }}–{{ session.endsAt | isoTime }}</span>
                    </div>
                    <div class="program-session__heading">
                      {% if session.isService %}
                        {# Breaks, lunch, registration, the party — nothing to open, so no button. #}
                        <span class="program-session__title">{{ session.title }}</span>
                      {% else %}
                        <button type="button" class="program-session__title" data-session-open aria-haspopup="dialog">
                          {{ session.title }}
                        </button>
                      {% endif %}
                      {% if not session.isService %}
                        <button type="button" class="program-session__favorite" data-session-favorite aria-label="{{ t.program.star }}: {{ session.title | escape }}" aria-pressed="false"><svg class="favorite-star" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.41L14.13 9.97L21.04 9.97L15.45 14.03L17.58 20.59L12 16.54L6.42 20.59L8.55 14.03L2.96 9.97L9.87 9.97Z"/></svg></button>
                      {% endif %}
                    </div>
                    {% if session.speakers and not session.isService %}
                      <div class="program-session__speakers">
                        {% for speakerId in session.speakers %}
                          {% set speaker = sessionize.speakers | speakerById(speakerId) %}
                          {% if speaker %}
                            <button
                              type="button"
                              class="program-session__speaker"
                              data-speaker-open
                              aria-haspopup="dialog"
                              data-speaker-name="{{ (speaker.firstName + ' ' + speaker.lastName) | escape }}"
                              data-speaker-image="{{ speaker.profilePicture | escape }}"
                              data-speaker-tagline="{{ speaker.tagLine | escape }}"
                              data-speaker-bio="{{ speaker.bio | escape }}"
                              data-speaker-twitter="{{ speaker.twitter | escape }}"
                              data-speaker-linkedin="{{ speaker.linkedIn | escape }}"
                              data-speaker-blog="{{ speaker.blog | escape }}"
                              data-speaker-talk-title="{{ session.title | escape }}"
                              data-speaker-talk-description="{{ session.description | escape }}"
                            >{{ speaker.firstName }} {{ speaker.lastName }}</button>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}
                    {% if not session.isService %}{{ sessionLanguage(session.language, t) }}{% endif %}
                  </article>
                {% endfor %}
              </div>
            </div>
          {% endfor %}

          {% for session in sessionize.schedule.overlays %}
            <article
              class="program-session program-session--service program-session--plenum program-session--long-service-overlay"
              style="--program-room-start: {{ session.roomStart + 1 }}; --program-room-end: {{ session.roomEnd + 2 }}"
              data-program-session
              data-session-id="{{ session.id | escape }}"
              data-session-title="{{ session.title | escape }}"
              data-session-description="{{ session.description | escape }}"
              data-session-start="{{ session.startsAt | isoTime }}"
              data-session-end="{{ session.endsAt | isoTime }}"
              data-session-start-at="{{ session.startsAt }}"
              data-session-end-at="{{ session.endsAt }}"
              data-session-room="{{ session.roomName | escape }}"
              data-session-service="true"
              data-session-topics=""
              data-session-long-service="true"
            >
              <div class="program-session__meta">
                <span class="program-session__room">{{ session.roomName or t.program.shared_session }}</span>
                <span class="program-session__duration">{{ session.startsAt | isoTime }}–{{ session.endsAt | isoTime }}</span>
              </div>
              <div class="program-session__heading">
                {# Always a service session (the party, dinner, ...) — nothing to open. #}
                <span class="program-session__title">{{ session.title }}</span>
              </div>
            </article>
          {% endfor %}
        </div>

        <dialog class="detail-modal program-session-modal" data-session-dialog aria-labelledby="program-session-modal-title">
          <div class="detail-modal__header">
            <button type="button" class="detail-modal__close" data-session-close aria-label="{{ t.program.close }}" autofocus>
              <svg class="detail-modal__close-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
            </button>
          </div>
          <div class="detail-modal__scroll">
            <p class="program-session-modal__meta" data-session-modal-meta-row>
              <span data-session-modal-meta></span>
              <span class="program-session-modal__language" data-session-modal-language></span>
            </p>
            <h3 id="program-session-modal-title" data-session-modal-title></h3>
            <p class="program-session-modal__description" data-session-modal-description></p>

            {# Filled by TdcProgram from the session's own [data-speaker-open]
               buttons — one dialog, not a separate speaker one to jump to. #}
            <div class="program-session-modal__speakers-section" data-session-modal-speakers-section hidden>
              {# JS swaps this for the singular label when there's only one speaker;
                 the plural here is just the no-JS/pre-render fallback. #}
              <h4 class="program-session-modal__speakers-title" data-session-modal-speakers-title>{{ t.speakers.title }}</h4>
              <div class="program-session-modal__speakers" data-session-modal-speakers></div>
            </div>
          </div>
          <div class="detail-modal__actions">
            <button type="button" class="program-session-modal__favorite" data-session-modal-favorite aria-pressed="false">
              <svg class="favorite-star" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.41L14.13 9.97L21.04 9.97L15.45 14.03L17.58 20.59L12 16.54L6.42 20.59L8.55 14.03L2.96 9.97L9.87 9.97Z"/></svg>
              <span data-session-modal-favorite-label></span>
            </button>
            <div class="calendar-menu" data-calendar-menu>
              {# Opens a chooser rather than adding anything. It is a disclosure of
                 plain links, not a menu widget, so aria-expanded says so (not
                 aria-haspopup, which promises arrow-key menu navigation); the
                 chevron says the same to sighted users, and the group label
                 names the chooser once it opens. #}
              <button type="button" class="program-session-modal__calendar" data-calendar-toggle aria-expanded="false" aria-controls="program-calendar-menu">
                <svg class="program-session-modal__calendar-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
                {{ t.program.calendar_add }}
                <svg class="program-session-modal__calendar-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 15 6-6 6 6"/></svg>
              </button>
              <div class="calendar-menu__list" id="program-calendar-menu" data-calendar-list role="group" aria-label="{{ t.program.calendar_menu }}" hidden>
                <a class="calendar-menu__item" href="#" target="_blank" rel="noopener" data-calendar-link="google">
                  <svg class="calendar-menu__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
                  {{ t.program.calendar_google }}
                  <span class="visually-hidden">({{ t.ui.external }})</span>
                </a>
                <a class="calendar-menu__item" href="#" target="_blank" rel="noopener" data-calendar-link="outlook">
                  <svg class="calendar-menu__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                  {{ t.program.calendar_outlook }}
                  <span class="visually-hidden">({{ t.ui.external }})</span>
                </a>
                <a class="calendar-menu__item" href="#" data-calendar-link="ics">
                  <svg class="calendar-menu__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M4 19h16"/></svg>
                  {{ t.program.calendar_ics }}
                </a>
              </div>
            </div>
          </div>
        </dialog>

        <template data-language-badges>{{ sessionLanguage("en", t) }}{{ sessionLanguage("no", t) }}</template>
      {% else %}
        <p class="section__lead text-lead">{{ t.program.placeholder }}</p>
      {% endif %}
    </div>
  </div>
</section>
</tdc-section>
