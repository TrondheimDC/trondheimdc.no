<tdc-section>
<section class="section" id="program" aria-labelledby="program-title">
  <div class="container container--wide stack">
    <header class="section__header">
      {# Standalone /program/ page: the schedule is the page, so it owns the h1. #}
      {% if standalone %}
        <h1 class="section__title text-h1" id="program-title">{{ t.program.title }}</h1>
      {% else %}
        <h2 class="section__title text-h1" id="program-title">{{ t.program.title }}</h2>
      {% endif %}
    </header>

    <div
      class="program-schedule"
      aria-label="{{ t.program.title }}"
      data-sessionize-event-id="{{ site.sessionizeEventId }}"
      data-favorites-key="tdc-favorites-{{ sessionize.eventId }}"
      data-star-label="{{ t.program.star }}"
      data-unstar-label="{{ t.program.unstar }}"
      data-show-favorites-label="{{ t.program.show_favorites }}"
      data-show-all-label="{{ t.program.show_all }}"
      data-all-topics-label="{{ t.program.all_topics }}"
      data-topic-label="{{ t.program.topic }}"
      data-shared-session-label="{{ t.program.shared_session }}"
      data-calendar-url="{{ site.url }}{{ page.url }}{% if not standalone %}#program{% endif %}"
      data-calendar-ics-base="{{ '/program/' | url }}"
      data-calendar-saved-name="{{ t.program.calendar_saved_name | escape }}"
    >
      {% if sessionize.schedule.rows and sessionize.schedule.rows.length > 0 %}
        <h3 class="program-schedule__date">{{ sessionize.schedule.date | date(lang) }}</h3>
        <div class="program-schedule__toolbar">
          <p class="program-schedule__hint">{{ t.program.favorite_hint }}</p>
          <div class="program-schedule__filters">
            <label class="program-schedule__search-label" for="program-search">{{ t.program.search_label }}</label>
            <input class="program-schedule__search" id="program-search" type="search" data-program-search placeholder="{{ t.program.search_placeholder | escape }}" autocomplete="off" />
            <div class="program-schedule__topic-control">
              <label class="program-schedule__topic-label" for="program-topic-filter">{{ t.program.topic }}</label>
              <select class="program-schedule__topic" id="program-topic-filter" data-program-topic-filter>
                <option value="">{{ t.program.all_topics }}</option>
                {% for topic in sessionize.schedule.topics %}
                  <option value="{{ topic | escape }}">{{ topic }}</option>
                {% endfor %}
              </select>
            </div>
            <button type="button" class="program-schedule__filter" data-program-favorites-only aria-pressed="false">
              <span aria-hidden="true">☆</span> {{ t.program.show_favorites }}
            </button>
            <button type="button" class="program-schedule__filter" data-program-calendar-export disabled>{{ t.program.calendar_saved }}</button>
          </div>
        </div>
        <p class="program-schedule__no-results" data-program-search-empty hidden>{{ t.program.no_results }}</p>

        <div class="program-schedule__grid" style="--program-room-count: {{ sessionize.schedule.rooms.length }}">
          <div class="program-schedule__rooms" aria-hidden="true">
            <span></span>
            {% for room in sessionize.schedule.rooms %}
              <span class="program-schedule__room-label">{{ room.name }}</span>
            {% endfor %}
          </div>

          {% for row in sessionize.schedule.rows %}
            <div class="program-schedule__row" data-program-time="{{ row.startsAt }}">
              <time class="program-schedule__time" datetime="{{ row.startsAt }}">{{ row.startsAt | isoTime }}</time>
              <div class="program-schedule__sessions">
                {% for session in row.sessions %}
                  <article
                    class="program-session{% if session.isService %} program-session--service{% endif %}{% if session.isPlenum %} program-session--plenum{% endif %}{% if session.isLongService %} program-session--long-service-in-row{% endif %}{% if not session.isService %} program-session--favoritable{% endif %}"
                    style="--program-room-start: {{ session.roomStart + 1 }}; --program-room-end: {{ session.roomEnd + 2 }}"
                    data-program-session
                    data-session-id="{{ session.id | escape }}"
                    data-session-title="{{ session.title | escape }}"
                    data-session-description="{{ session.description | escape }}"
                    data-session-start="{{ session.startsAt | isoTime }}"
                    data-session-end="{{ session.endsAt | isoTime }}"
                    data-session-start-at="{{ session.startsAt }}"
                    data-session-end-at="{{ session.endsAt }}"
                    data-session-room="{{ session.roomName | escape }}"
                    data-session-service="{{ 'true' if session.isService else 'false' }}"
                    data-session-topics="{{ session.topics | join('|') | escape }}"
                  >
                    <div class="program-session__meta">
                      <span class="program-session__room">{% if session.title == "Lunch" %}{{ t.program.lunch_location }}{% else %}{{ session.roomName or t.program.shared_session }}{% endif %}</span>
                      <span class="program-session__duration">{{ session.startsAt | isoTime }}–{{ session.endsAt | isoTime }}</span>
                    </div>
                    <div class="program-session__heading">
                      <button type="button" class="program-session__title" data-session-open>
                        {{ session.title }}
                      </button>
                      {% if not session.isService %}
                        <button type="button" class="program-session__favorite" data-session-favorite aria-label="{{ t.program.star }}: {{ session.title | escape }}" aria-pressed="false"><svg class="favorite-star" viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.41L14.13 9.97L21.04 9.97L15.45 14.03L17.58 20.59L12 16.54L6.42 20.59L8.55 14.03L2.96 9.97L9.87 9.97Z"/></svg></button>
                      {% endif %}
                    </div>
                    {% if session.speakers and not session.isService %}
                      <div class="program-session__speakers">
                        {% for speakerId in session.speakers %}
                          {% set speaker = sessionize.speakers | speakerById(speakerId) %}
                          {% if speaker %}
                            <button
                              type="button"
                              class="program-session__speaker"
                              data-speaker-open
                              data-speaker-name="{{ (speaker.firstName + ' ' + speaker.lastName) | escape }}"
                              data-speaker-image="{{ speaker.profilePicture | escape }}"
                              data-speaker-tagline="{{ speaker.tagLine | escape }}"
                              data-speaker-bio="{{ speaker.bio | escape }}"
                              data-speaker-talk-title="{{ session.title | escape }}"
                              data-speaker-talk-description="{{ session.description | escape }}"
                            >{{ speaker.firstName }} {{ speaker.lastName }}</button>
                          {% endif %}
                        {% endfor %}
                      </div>
                    {% endif %}
                  </article>
                {% endfor %}
              </div>
            </div>
          {% endfor %}

          {% for session in sessionize.schedule.overlays %}
            <article
              class="program-session program-session--service program-session--plenum program-session--long-service-overlay"
              style="--program-room-start: {{ session.roomStart + 1 }}; --program-room-end: {{ session.roomEnd + 2 }}"
              data-program-session
              data-session-id="{{ session.id | escape }}"
              data-session-title="{{ session.title | escape }}"
              data-session-description="{{ session.description | escape }}"
              data-session-start="{{ session.startsAt | isoTime }}"
              data-session-end="{{ session.endsAt | isoTime }}"
              data-session-start-at="{{ session.startsAt }}"
              data-session-end-at="{{ session.endsAt }}"
              data-session-room="{{ session.roomName | escape }}"
              data-session-service="true"
              data-session-topics=""
              data-session-long-service="true"
            >
              <div class="program-session__meta">
                <span class="program-session__room">{{ session.roomName or t.program.shared_session }}</span>
                <span class="program-session__duration">{{ session.startsAt | isoTime }}–{{ session.endsAt | isoTime }}</span>
              </div>
              <div class="program-session__heading">
                <button type="button" class="program-session__title" data-session-open>{{ session.title }}</button>
              </div>
            </article>
          {% endfor %}
        </div>

        <dialog class="program-session-modal" data-session-dialog aria-labelledby="program-session-modal-title">
          <button type="button" class="program-session-modal__close" data-session-close aria-label="{{ t.program.close }}" autofocus>✕</button>
          <p class="program-session-modal__meta" data-session-modal-meta></p>
          <h3 id="program-session-modal-title" data-session-modal-title></h3>
          <p class="program-session-modal__description" data-session-modal-description></p>
          <div class="program-session-modal__actions">
            <button type="button" class="program-session-modal__favorite" data-session-modal-favorite aria-pressed="false">
              <svg class="favorite-star" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" stroke-linejoin="round" aria-hidden="true"><path d="M12 3.41L14.13 9.97L21.04 9.97L15.45 14.03L17.58 20.59L12 16.54L6.42 20.59L8.55 14.03L2.96 9.97L9.87 9.97Z"/></svg>
              <span data-session-modal-favorite-label></span>
            </button>
            <div class="calendar-menu" data-calendar-menu>
              <button type="button" class="program-session-modal__calendar" data-calendar-toggle aria-expanded="false" aria-controls="program-calendar-menu">{{ t.program.calendar_add }}</button>
              <div class="calendar-menu__list" id="program-calendar-menu" data-calendar-list hidden>
                <a class="calendar-menu__item" href="#" target="_blank" rel="noopener" data-calendar-link="google">
                  <svg class="calendar-menu__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 11h18"/></svg>
                  {{ t.program.calendar_google }}
                </a>
                <a class="calendar-menu__item" href="#" target="_blank" rel="noopener" data-calendar-link="outlook">
                  <svg class="calendar-menu__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg>
                  {{ t.program.calendar_outlook }}
                </a>
                <a class="calendar-menu__item" href="#" data-calendar-link="ics">
                  <svg class="calendar-menu__icon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M4 19h16"/></svg>
                  {{ t.program.calendar_ics }}
                </a>
              </div>
            </div>
          </div>
        </dialog>
      {% else %}
        <p class="section__lead text-lead">{{ t.program.placeholder }}</p>
      {% endif %}
    </div>
  </div>
</section>
</tdc-section>
