{# Session language — the name of the language a talk is held in.
   Sessionize's "Language" category only ever has English or Norwegian; any
   other value arrives as an empty code and renders nothing.

   The visible word follows the page language (Norsk / Engelsk, or
   Norwegian / English). #}
{% macro sessionLanguage(code, t) %}
  {%- if code == "en" or code == "no" -%}
    {%- set label = t.program.language_en if code == "en" else t.program.language_no -%}
    <span class="session-language" data-session-language="{{ code }}" title="{{ t.program.language }}: {{ label }}">{{ label }}</span>
  {%- endif -%}
{% endmacro %}
