{#
  Speaker detail dialog, driven by assets/js/components/tdc-speaker-modal.js.

  It is a partial rather than markup inside sections/speakers.njk because the
  standalone /program/ page renders the schedule without the speaker wall, and
  the speaker names in the grid open this very dialog. The IDs are global, so
  include it exactly once per page: speakers.njk owns it on the home page, and
  sections/program.njk adds it only when it is rendered standalone.
#}
<dialog class="speaker-modal" id="speaker-description-modal" aria-labelledby="speaker-modal-name">
  <div class="speaker-modal__header">
    <button type="button" class="speaker-modal__close" data-speaker-close aria-label="{{ t.program.close }}" autofocus>✕</button>
  </div>
  <div class="speaker-modal__content">
    <div class="speaker-modal__header-info">
      <img class="speaker-modal__avatar" id="speaker-modal-avatar" src="" alt="" />
      <div class="speaker-modal__heading">
        <h3 class="speaker-modal__name" id="speaker-modal-name"></h3>
        <p class="speaker-modal__tagline" id="speaker-modal-tagline"></p>
      </div>
    </div>

    <p class="speaker-modal__bio" id="speaker-modal-bio"></p>

    <div class="speaker-modal__talk" id="speaker-modal-talk">
      <div class="speaker-modal__talk-heading">
        <h4 class="speaker-modal__talk-title" id="speaker-modal-talk-title"></h4>
        <span class="speaker-modal__talk-language" id="speaker-modal-talk-language"></span>
      </div>
      <p class="speaker-modal__talk-description" id="speaker-modal-talk-description"></p>
    </div>

    <div class="speaker-modal__socials" id="speaker-modal-socials"></div>
  </div>
</dialog>
